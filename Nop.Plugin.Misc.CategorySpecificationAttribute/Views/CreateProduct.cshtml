            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="exampleRadios" id="exampleRadios2" value="option2">
                <label class="form-check-label" for="exampleRadios2">
                    Yeni ve etiketli
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="exampleRadios" id="exampleRadios3" value="option3">
                <label class="form-check-label" for="exampleRadios3">
                    Az kullanılmış
                </label>
            </div>*@
        </div>
        <div class="tab-pane fade" id="contact" role="tabpanel" aria-labelledby="contact-tab">
            <form asp-controller="Product" asp-action="Create" method="post" id="product-form">
                <div class="form-group">
                    <nop-label asp-for="@Model.Name"></nop-label>
                    <nop-editor asp-for="@Model.Name" asp-required="true"></nop-editor>
                    <span asp-validation-for="@Model.Name"></span>
                </div>
                <div class="form-group">
                    <nop-label asp-for="@Model.ShortDescription"></nop-label>
                    <nop-textarea class="form-control" asp-for="@Model.ShortDescription" rows="7"></nop-textarea>
                    <span asp-validation-for="@Model.ShortDescription"></span>
                </div>
                <div class="form-group" id="product-price-area">
                    <nop-label asp-for="@Model.Price" />
                    <nop-editor asp-for="@Model.Price" asp-postfix="@Model.PrimaryStoreCurrencyCode" />
                    <span asp-validation-for="@Model.Price"></span>
                </div>
                @if (Model.ProductEditorSettingsModel.OldPrice)
                {
                    <div class="form-group">
                        <nop-label asp-for="@Model.OldPrice" />
                        <nop-editor asp-for="@Model.OldPrice" asp-postfix="@Model.PrimaryStoreCurrencyCode" />
                        <span asp-validation-for="@Model.OldPrice"></span>
                    </div>
                }
                <button type="button" name="save" class="btn btn-primary" onclick="saveProduct()" id="save-button">
                    <i class="far fa-save"></i>
                    @T("Admin.Common.Save")
                </button>
            </form>
        </div>
