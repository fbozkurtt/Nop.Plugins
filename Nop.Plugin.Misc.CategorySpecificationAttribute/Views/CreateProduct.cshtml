@model ProductModel
@using Nop.Core.Domain.Catalog;
@using Nop.Services
@using Nop.Services.Stores

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
@*<!DOCTYPE html>
    <head>
        <title>Yeni bir ürün ekle</title>*@
@*<link href="~/Plugins/Misc.CategorySpecificationAttribute/Views/Content/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Plugins/Misc.CategorySpecificationAttribute/Views/Content/js/jquery-3.5.1.min.js"></script>
    <script src="~/Plugins/Misc.CategorySpecificationAttribute/Views/Content/js/bootstrap.bundle.min.js"></script>*@
<script>
    function loadSpecificationAttributeOptions() {
        selectedCategoryIds = Array.from(document.getElementById('@Html.IdFor(model => model.SelectedCategoryIds)').options).filter(o => o.selected).map(o => o.value);
        var selectedCategoryId = selectedCategoryIds[0];
        var specificationAttributesData = [];
        $.ajax({
            cache: false,
            type: "GET",
            url: "@Url.Action("GetSpecificationAttributesByCategoryId", "CategorySpecificationAttribute")" + "?categoryId=" + selectedCategoryId,
            success: function (data, textStatus, jqXHR) {
                console.log("GET: SpecAttributeOptions")
                specificationAttributesData = data;
            },
            error: function (jqXHR, textStatus, errorThrown) {
                console.error('Error ' + textStatus);
            },
            complete: function (jqXHR, textStatus) {
                $("#specificationAttributes").empty();
                var content = '';
                $.each(specificationAttributesData, function (i, attributeGroup) {
                    var innerContent = '';
                    $.each(attributeGroup.specificationAttributes, function (j, specificationAttribute) {
                        var optionContent = '';
                        $.each(specificationAttribute.options, function (k, option) {
                            optionContent += '<option value=\"' + option.id + '\">' + option.name + '</option>'
                        })
                        innerContent += '<div class=\"form-group\"><label>' + specificationAttribute.name + '</label><select class=\"form-control\" name=\"specificationAttribute\">' + optionContent + '</select></div>';
                    });
                    content += '<div class=\"mt-3\"><h4>' + attributeGroup.name + '</h4>' + innerContent + '</div>';
                    $("#specificationAttributes").append(content);
                });
            }
        });
    }
</script>
@*</head>
    <body>*@
<div class="container">
    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link active" id="home-tab" data-toggle="tab" href="#home" role="tab" aria-controls="home" aria-selected="true">Fotoğraf</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" id="profile-tab" data-toggle="tab" href="#profile" role="tab" aria-controls="profile" aria-selected="false">Ürün Bilgileri</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" id="contact-tab" data-toggle="tab" href="#contact" role="tab" aria-controls="contact" aria-selected="false">Onayla</a>
        </li>
    </ul>
    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">

        </div>
        <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
            <div class="form-group mt-3">
                <nop-label asp-for="@Model.SelectedCategoryIds" />
                <nop-select asp-for="@Model.SelectedCategoryIds" asp-items="@Model.AvailableCategories" />
                <script>
                        $(document).ready(function () {
                            $('#@Html.IdFor(model => model.SelectedCategoryIds)').change(function () {
                                loadSpecificationAttributeOptions();
                            });
                            //loadSpecificationAttributeOptions();
                        });
                </script>
            </div>
            <div id="specificationAttributes">
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="exampleRadios" id="exampleRadios1" value="option1" checked>
                <label class="form-check-label" for="exampleRadios1">
                    Yeni
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="exampleRadios" id="exampleRadios2" value="option2">
                <label class="form-check-label" for="exampleRadios2">
                    Yeni ve etiketli
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="exampleRadios" id="exampleRadios3" value="option3">
                <label class="form-check-label" for="exampleRadios3">
                    Az kullanılmış
                </label>
            </div>
        </div>
        <div class="tab-pane fade" id="contact" role="tabpanel" aria-labelledby="contact-tab">
            <form asp-controller="Product" asp-action="Create" method="post" id="product-form">
                <div class="form-group">
                    <nop-label asp-for="@Model.Name"></nop-label>
                    <nop-editor asp-for="@Model.Name" asp-required="true"></nop-editor>
                    <span asp-validation-for="Name"></span>
                </div>
                <div class="form-group">
                    <nop-label asp-for="@Model.ShortDescription"></nop-label>
                    <nop-textarea class="form-control" asp-for="@Model.ShortDescription" rows="7"></nop-textarea>
                    <span asp-validation-for="@Model.ShortDescription"></span>
                </div>
                <div class="form-group" id="product-price-area">
                    <nop-label asp-for="Price" />
                    <nop-editor asp-for="Price" asp-postfix="@Model.PrimaryStoreCurrencyCode" />
                    <span asp-validation-for="Price"></span>
                </div>
                @if (Model.ProductEditorSettingsModel.OldPrice)
                {
                    <div class="form-group">
                        <nop-label asp-for="@Model.OldPrice" />
                        <nop-editor asp-for="@Model.OldPrice" asp-postfix="@Model.PrimaryStoreCurrencyCode" />
                        <span asp-validation-for="OldPrice"></span>
                    </div>
                }
            </form>
        </div>
    </div>
</div>
@*</body>*@