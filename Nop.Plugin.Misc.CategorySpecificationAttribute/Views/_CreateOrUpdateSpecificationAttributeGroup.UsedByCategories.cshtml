@model SpecificationAttributeGroupCategoryModel

@{
    const string hideCategoryBlockAttributeGroupName = "SpecificationAttributeGroupPage.HideCategoryBlock";
    var hideCategoryBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideCategoryBlockAttributeGroupName);
}

<form asp-controller="CategorySpecificationAttribute" asp-action="Create" method="post" id="category-form">
    <nop-card asp-name="specification-attribute-group-category" asp-icon="fas fa-info" asp-title="Category" asp-hide-block-attribute-name="@hideCategoryBlockAttributeGroupName" asp-hide="@hideCategoryBlock" asp-advanced="false">
        <div class="card-body">
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="@Model.SelectedCategoryIds" />
                </div>
                <div class="col-md-6">
                    <nop-select asp-for="@Model.SelectedCategoryIds" asp-items="@Model.AvailableCategories" asp-multiple="true" />
                    <script>
                        $(document).ready(function() {
				        	var categoryIdsInput = $('#@Html.IdFor(model => model.SelectedCategoryIds)').data("kendoMultiSelect");
				        	categoryIdsInput.setOptions({
                            autoClose: false,
                            filter: "contains"
                            });

				        @if (Model.AvailableCategories.Count == 0)
                        {
                            <text>
                                categoryIdsInput.setOptions({
                                    enable: false,
                                    placeholder: '@T("Admin.Catalog.Products.Fields.Categories.NoCategoriesAvailable")'
                                });
                                categoryIdsInput._placeholder();
                                categoryIdsInput._enable();
                            </text>
                        }
                        });
                    </script>
                </div>
                <div class="col-md-3">
                    <button type="button" name="save-categories" class="btn btn-primary">
                        <i class="far fa-save"></i>
                        @T("Admin.Common.Save")
                    </button>
                </div>
            </div>
        </div>
    </nop-card>
</form>