@model ProductModel
@using Nop.Core.Domain.Catalog;
@using Nop.Services
@using Nop.Services.Stores

@{
    Layout = "~/Views/Shared/_ColumnsOne.cshtml";

    //title
    Html.AddTitleParts("Yeni Ürün Ekle");
    //page class
    //Html.AppendPageCssClassParts("html-contact-page");

    Html.AddScriptParts(ResourceLocation.Head, "~/lib_npm/jquery/jquery.min.js");
}
<script>
    var pictureId;
    $(document).ready(function () {
        document.getElementsByClassName('center-1')[0].classList.add('col');
    });
    function loadSpecificationAttributeOptions() {
        selectedCategoryIds = Array.from(document.getElementById('@Html.IdFor(model => model.SelectedCategoryIds)').options).filter(o => o.selected).map(o => o.value);
        var selectedCategoryId = selectedCategoryIds[0];
        $.ajax({
            cache: false,
            type: "GET",
            url: "@Url.Action("GetSpecificationAttributesByCategoryId", "CategorySpecificationAttributeGroup")" + "?categoryId=" + selectedCategoryId,
            success: function (data, textStatus, jqXHR) {
                console.log("GET: SpecAttributeOptions")
                console.log(data);
                $("#specificationAttributes").empty();
                var content = '';
                $.each(data, function (i, attributeGroup) {
                    var innerContent = '';
                    $.each(attributeGroup.specificationAttributes, function (j, specificationAttribute) {
                        var optionContent = '';
                        $.each(specificationAttribute.options, function (k, option) {
                            optionContent += '<option value=\"' + option.id + '\">' + option.name + '</option>'
                        })
                        innerContent += '<div class=\"form-group\"><label>' + specificationAttribute.name + '</label><select class=\"form-control\" name=\"specificationAttribute\">' + optionContent + '</select></div>';
                    });
                    content += '<div class=\"mt-3\"><h4>' + attributeGroup.name + '</h4>' + innerContent + '</div>';
                    $("#specificationAttributes").append(content);
                    content = '';
                });
            },
            error: function (jqXHR, textStatus, errorThrown) {
                console.error('Error ' + textStatus);
            },
            complete: function (jqXHR, textStatus) {
            }
        });
    }

    function saveSpecificationAttributes(productId) {
        var specificationAttributeOptionIds = [];
        var specificationAttributesData = document.getElementsByName('specificationAttribute');
        $.each(specificationAttributesData, function (i, specificationAttribute) {
            specificationAttributeOptionIds.push(specificationAttribute.value);
        });
        var postData = {
            specificationAttributeOptionIds: specificationAttributeOptionIds,
            productId: productId
        }
        addAntiForgeryToken(postData);
        $.ajax({
            cache: false,
            type: "POST",
            url: "@Url.Action("ProductSpecificationAttributeAdd", "Product")",
            data: postData,
            success: function (data, textStatus, jqXHR) {
                saveProductPicture(productId);
            },
            error: function (jqXHR, textStatus, errorThrown) {
                console.error('Error ' + textStatus);
            },
            complete: function (jqXHR, textStatus) {
            }
        });
    }

    function saveProduct() {
        $("#save-button").prop("disabled", true);
        var postData = @Html.Raw(Json.Serialize(Model));
        var selectedCategoryIds = Array.from(document.getElementById('@Html.IdFor(model => model.SelectedCategoryIds)').options).filter(o => o.selected).map(o => o.value);
        postData.SelectedCategoryIds = selectedCategoryIds;
        postData.Name = $('#@Html.IdFor(model => model.Name)').val();
        postData.ShortDescription = $('#@Html.IdFor(model => model.ShortDescription)').val();
        postData.Price = $('#@Html.IdFor(model => model.Price)').val();
        @if (Model.ProductEditorSettingsModel.OldPrice)
        {
            <text>
                postData.OldPrice = $('#@Html.IdFor(model => model.OldPrice)').val();
            </text>
        }
        addAntiForgeryToken(postData);
        console.log(postData);
        $.ajax({
            cache: false,
            type: "POST",
            url: "@Url.Action("Create", "Product")",
            data: postData,
            success: function (data, textStatus, jqXHR) {
                saveSpecificationAttributes(data);
            },
            error: function (jqXHR, textStatus, errorThrown) {
                console.error('Error ' + textStatus);
            },
            complete: function (jqXHR, textStatus) {
            }
        });
    }

    function saveProductPicture(productId) {
        //var pictureId = $("#@Html.IdFor(model => model.AddPictureModel.PictureId)").val();
        var overrideAltAttribute = $("#@Html.IdFor(model => model.AddPictureModel.OverrideAltAttribute)").val();
        var overrideTitleAttribute = $("#@Html.IdFor(model => model.AddPictureModel.OverrideTitleAttribute)").val();
        var displayOrder = $("#@Html.IdFor(model => model.AddPictureModel.DisplayOrder)").val();

        if (pictureId == 0) {
            $("#addProductPictureAlert").click();
            return;
        }

        $('#addProductPicture').attr('disabled', true);

        var postData = {
            pictureId: pictureId,
            displayOrder: displayOrder,
            overrideAltAttribute: overrideAltAttribute,
            overrideTitleAttribute: overrideTitleAttribute,
            productId: productId
        };
        addAntiForgeryToken(postData);

        $.ajax({
            cache: false,
            type: "POST",
            url: "@(Url.Action("ProductPictureAdd", "/Product"))",
            data: postData,
            success: function (data, textStatus, jqXHR) {
                if (!data.Result) {
                    return;
                }
                document.location = '@Url.Action("Index", "Home")';
            },
            error: function (jqXHR, textStatus, errorThrown) {

            },
            complete: function (jqXHR, textStatus) {
                $("#save-button").prop("disabled", false);
            }
        });
    }

    $(document).ready(function () {
        $('#@Html.IdFor(model => model.AddPictureModel.PictureId)').change(function () {
            var input = document.getElementById('@Html.IdFor(model => model.AddPictureModel.PictureId)');
            const reader = new FileReader()

            reader.onload = async (event) => {
                document.getElementById('picturePreview').setAttribute('src', event.target.result)
            }
            reader.readAsDataURL(input.files[0])
            if (input)
            {
                var formData = new FormData();
                formData.append('file', input.files[0]);

                $.ajax({
                    cache: false,
                    type: "POST",
                    url: "@Url.Action("Upload", "Picture")",
                    contentType: false,
                    processData: false,
                    data: formData,
                    dataType: 'json',
                    success: function (data, textStatus, jqXHR) {
                        if (data.success)
                            pictureId = data.pictureId;
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.error('Error ' + textStatus);
                    },
                    complete: function (jqXHR, textStatus) {
                    }
                });
            }
        });
    });
</script>

